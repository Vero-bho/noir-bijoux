{
  "name": "noir-bijoux-backend",
  "version": "1.0.0",
  "description": "REST API интернет-магазина авторской бижутерии Noir Bijoux (Express + TypeScript + Prisma + PostgreSQL/Supabase)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:sql": "prisma migrate diff --from-empty --to-schema src/prisma/schema/schema.prisma --script",
    "db:push": "prisma db push",
    "seed": "tsx src/prisma/seed.ts",
    "test:api": "tsc && node tests/api.test.js",
    "test:seed": "tsc && node tests/seed.test.js",
    "test": "npm run test:sql && npm run test:sql:pg && npm run test:api && npm run test:seed && npm run test:postman",
    "test:postman": "tsc && node tests/postman.test.js",
    "demo": "tsc && node scripts/demo-server.js",
    "test:sql": "node tests/sql.test.js",
    "db:check": "tsc && node scripts/db-check.js",
    "test:sql:pg": "node tests/sql-postgres.test.js",
    "check:files": "node scripts/check-structure.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "newman": "^6.2.2",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
